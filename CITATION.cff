cff-version: 1.2.0
title: "CPS-0001: The Continuity Protocol Standard"
message: "If you use CPS-0001 in your research or implementation, please cite this work."
type: standard
authors:
  - name: "The Continuity Lab"
    website: "https://thecontinuitylab.org"
repository-code: "https://github.com/myshapeprotocol/myshape-protocol"
url: "https://myshape.com/research/notes/008-continuity-protocol-core"
abstract: "CPS-0001 defines the Continuity Receipt — a cryptographically verifiable statement that an observer collected sufficient evidence supporting the continuity of a subject over a bounded interval of time. It is engine-independent: no sensor type, algorithm, or hardware requirement appears in the specification."
keywords:
  - "continuity protocol"
  - "identity verification"
  - "behavioral biometrics"
  - "zero-knowledge proofs"
  - "motion signature"
  - "Ed25519"
  - "decentralized identity"
  - "proof of continuity"
license: Apache-2.0
version: "1.0-RC"
date-released: "2026-07-24"
