{
  "name": "@thecontinuitylab/myshape",
  "version": "0.3.0",
  "description": "MyShape Protocol — one function call adds continuity verification to your application. CPS-0001 compatible. Engine-independent.",
  "license": "Apache-2.0",
  "author": "The Continuity Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myshapeprotocol/myshape-protocol.git"
  },
  "keywords": [
    "motion-signature",
    "continuity",
    "verification",
    "presence",
    "pes",
    "cps-0001",
    "ed25519",
    "zero-knowledge",
    "proof-of-continuity",
    "kinetic-verification",
    "imu",
    "sensor-fusion",
    "protocol",
    "temporal-trust",
    "on-device",
    "privacy-preserving",
    "continuity-protocol",
    "typescript",
    "research"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "myshape": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.0.0",
    "@noble/hashes": "^1.0.0"
  }
}
